# Copia in backend/.env e inserisci i tuoi valori. Non committare mai il file .env.

# MongoDB
serverDB=mongodb://127.0.0.1:27017/

# Firma dei token JWT (stringa casuale lunga)
JWT_key=change-me

# Stripe (usa una chiave di TEST: sk_test_...)
stripe_Key_test=sk_test_xxxxxxxxxxxxxxxx
url=http://127.0.0.1:8080

# Proxmox
proxmoxHOST=192.0.2.10
host=https://192.0.2.10:8006/
userProxmox=user@pve
pswProxmox=change-me
tokenID=token-name
token_key=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
nameNode=pve
templateID=100
startID=200

# Password SSH dei container (meglio usare chiavi SSH)
ssh_key=change-me
